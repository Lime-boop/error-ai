# No Vercel environment variables are required for Supabase.
# The public Supabase URL and publishable key are safe client-side values.

# Add this secret manually in Supabase Dashboard:
# Edge Functions -> Secrets
GEMINI_API_KEY=

# Gemini model selection is managed in the Edge Function source:
# Primary: gemini-3.7-flash
# Fallback: gemini-3.6-flash
